<Window
    x:Class="CopilotTaskbarApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CopilotTaskbarApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent"
          CornerRadius="{StaticResource OverlayCornerRadius}">
        <Grid.Resources>
            
            <Style x:Key="SubtlerButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="ContentPresenter"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            CornerRadius="{TemplateBinding CornerRadius}"
                                            Padding="{TemplateBinding Padding}"
                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlFillColorTertiaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FlyoutHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}"/>
                <Setter Property="FontSize" Value="19"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            </Style>

            <Style x:Key="FlyoutSpeakerTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="LineHeight" Value="24"/>
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            </Style>
            
            <local:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Dark header like Win11 calendar flyout "Saturday, March 7" -->
          <Grid Grid.Row="0" x:Name="TitleBarDragRegion" Background="Transparent" 
              Padding="16,0,8,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="GitHub Copilot"
                       Style="{StaticResource FlyoutHeaderTextStyle}"
                       VerticalAlignment="Center"
                       Margin="0,12,0,12"/>
           
            <Button Grid.Column="1" 
                    Click="MinimizeButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Width="40" Height="40"
                    CornerRadius="0"
                    IsTabStop="False"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,4,0,4">
                <Button.Content>
                    <FontIcon Glyph="&#xE921;" FontSize="10"/>
                </Button.Content>
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemListLowColor}"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemListMediumColor}"/>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Lighter elevated content area like Win11 calendar grid -->
        <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ListView x:Name="ChatListView"
                      ItemsSource="{x:Bind _messages, Mode=OneWay}" 
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      Padding="16,8,16,8"
                      Background="Transparent"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollMode="Disabled">
                <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ChatMessage">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" 
                              Width="28" Height="28"
                              Margin="0,1,10,0"
                              VerticalAlignment="Top"
                              Visibility="{x:Bind ContentVisibility, Mode=OneWay}">
                            
                            <Image Source="{x:Bind AvatarImagePath, Mode=OneWay}"
                                   Width="24" 
                                   Height="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"
                                   Visibility="{x:Bind ImageVisibilityFixed, Mode=OneWay}"/>

                            <!-- User profile photo (circular) -->
                            <Border CornerRadius="12"
                                    Width="24" Height="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind UserAvatarVisibility, Mode=OneWay}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding AvatarImagePath}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>

                            <Border CornerRadius="14"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{x:Bind InitialVisibility, Mode=OneWay}">
                                <TextBlock Text="{x:Bind UserInitial, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"
                                           Foreground="White"/>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" Spacing="0" Margin="0,0,0,0"
                                     Visibility="{x:Bind ContentVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind RoleDisplay, Mode=OneWay}" 
                                       Style="{StaticResource FlyoutSpeakerTextStyle}"
                                       Padding="0"
                                       Margin="0,0,0,0"/>
                                       
                            <RichTextBlock IsTextSelectionEnabled="True"
                                           TextWrapping="WrapWholeWords"
                                           FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                                           FontSize="18"
                                           FontWeight="Normal"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           LineHeight="26"
                                           LineStackingStrategy="BlockLineHeight"
                                           Margin="0,0,0,0"
                                           Loaded="MessageContentRichText_Loaded"
                                           DataContextChanged="MessageContentRichText_DataContextChanged"/>
                                                      
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="{x:Bind FormattedTime, Mode=OneWay}" 
                                           x:Name="TimestampText"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind TimestampVisibility, Mode=OneWay}"/>
                                           
                                <Button Grid.Column="1"
                                        Style="{StaticResource SubtlerButtonStyle}"
                                        Click="CopyButton_Click"
                                        Visibility="{x:Bind CopyButtonVisibility, Mode=OneWay}"
                                        Padding="3"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        ToolTipService.ToolTip="Copy to clipboard">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Thinking animation: indeterminate ProgressRing (WinUI standard) -->
                        <ProgressRing Grid.ColumnSpan="2"
                                      IsActive="{x:Bind IsThinking, Mode=OneWay}"
                                      Visibility="{x:Bind ThinkingVisibility, Mode=OneWay}"
                                      Width="24" Height="24"
                                      Margin="0,4,0,4"
                                      HorizontalAlignment="Left"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        </ScrollViewer>

        <!-- Dark footer like Win11 calendar flyout "30 mins" / Focus bar -->
        <Grid Grid.Row="2" Background="Transparent" 
              Padding="12,6,12,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" 
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <AutoSuggestBox Grid.Column="0" x:Name="InputBox"
                            PlaceholderText="Ask GitHub Copilot..."
                            FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                            FontSize="18"
                            Padding="8,6,8,6"
                            Margin="0,0,8,0"
                            TextChanged="InputBox_TextChanged"
                            QuerySubmitted="InputBox_QuerySubmitted"
                            KeyDown="InputBox_KeyDown"/>

            <Button Grid.Column="1" x:Name="SendButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SendButton_Click"
                    Margin="0,0,0,0"
                    VerticalAlignment="Center"
                    Padding="8,6"
                    ToolTipService.ToolTip="Send Message">
                <FontIcon Glyph="&#xE768;" FontSize="{ThemeResource ControlContentThemeFontSize}"/>
            </Button>
        </Grid>
    </Grid>
</Window>
